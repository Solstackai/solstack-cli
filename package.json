{
  "name": "solstack",
  "version": "0.1.2",
  "description": "Spec-driven development with your coding agents, connected to your Solstack server: repository setup, workflow commands and the MCP bridge.",
  "keywords": [
    "solstack",
    "openspec",
    "spec-driven",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solstackai/solstack-cli.git"
  },
  "homepage": "https://github.com/Solstackai/solstack-cli#readme",
  "bugs": {
    "url": "https://github.com/Solstackai/solstack-cli/issues"
  },
  "type": "module",
  "bin": {
    "solstack": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.14.1",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "express": "^5.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
